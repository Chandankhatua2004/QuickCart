{
  "name": "quickcart-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "A modern e-commerce platform built with Next.js, MongoDB, and Clerk authentication",
  "keywords": ["ecommerce", "nextjs", "mongodb", "clerk", "tailwindcss"],
  "author": "Chandan Khatua",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "if exist .next rmdir /s /q .next && if exist out rmdir /s /q out",
    "analyze": "ANALYZE=true npm run build",
    "postbuild": "netlify build"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.27.1",
    "@netlify/plugin-nextjs": "^5.0.0",
    "mongoose": "^8.16.5",
    "next": "15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "eslint": "^9",
    "eslint-config-next": "15.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
